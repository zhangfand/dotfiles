{
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo run:*)",
      "Bash(grep:*)",
      "Bash(cargo test:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(curl:*)",
      "Bash(sqlite3:*)",
      "mcp__obsidian__write_note",
      "mcp__obsidian__search_notes",
      "mcp__obsidian__read_note",
      "mcp__obsidian__list_directory",
      "mcp__obsidian__read_multiple_notes",
      "mcp__obsidian__get_frontmatter",
      "mcp__obsidian__patch_note",
      "mcp__obsidian__manage_tags",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(uv run:*)",
      "Bash(npm run:*)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash -c 'plugin_dir=$(ls -d \"${CLAUDE_CONFIG_DIR:-$HOME/.claude}\"/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | awk -F/ '\"'\"'{ print $(NF-1) \"\\t\" $(0) }'\"'\"' | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n | tail -1 | cut -f2-); exec \"$(command -v bun || echo /opt/homebrew/bin/bun)\" --env-file /dev/null \"${plugin_dir}src/index.ts\" --extra-cmd \"$HOME/workspace/claude-code-plugins/pr-watch/hooks-handlers/hud-label.sh\"'"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "claude-hud@claude-hud": false,
    "understand-anything@understand-anything": true,
    "skill-creator@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "zstack@zstack": true,
    "swift-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "cloudflare@cloudflare": true
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "understand-anything": {
      "source": {
        "source": "git",
        "url": "https://github.com/Lum1104/Understand-Anything.git"
      }
    },
    "zstack": {
      "source": {
        "source": "github",
        "repo": "zhangfand/zstack"
      },
      "autoUpdate": true
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dotfiles-status.sh"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"$HOME/workspace/mirror/target/release/starshard\"; [ -x \"$s\" ] || exit 0; \"$s\" briefing --flavor compact 2>/dev/null"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "s=\"$HOME/workspace/mirror/target/release/starshard\"; [ -x \"$s\" ] || exit 0; \"$s\" briefing --flavor compact 2>/dev/null"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/comments-rulebook.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 || exit 0; python3 \"$f\"",
            "statusMessage": "Loading comment rulebook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/mirror-import.py\"; [ -f \"$f\" ] && command -v python3 >/dev/null 2>&1 || exit 0; python3 \"$f\""
          }
        ]
      }
    ]
  },
  "theme": "auto",
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": true
}
